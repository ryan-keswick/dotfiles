# Presence of this file disables stow's built-in default ignore list, so the
# defaults are replicated below. AGENTS.md also ships in the `home` stow
# package, and both target ~/AGENTS.md, causing a conflict. Ignore it here
# (the `home` package owns ~/AGENTS.md); the file still lives in this repo.

# --- stow default ignore list ---
RCS
.+,v
CVS
\.\#.+
\.cvsignore
\.svn
_darcs
\.hg
\.git
\.gitignore
\.gitmodules
.+~
\#.*\#
^/README.*
^/LICENSE.*
^/COPYING

# --- project-specific ---
^/AGENTS\.md$

# Bootstrap inputs and tests are not home-directory configuration.
^/mac_setup\.sh$
^/Brewfile(\.apps)?$
^/\.nvmrc$
^/tests$
